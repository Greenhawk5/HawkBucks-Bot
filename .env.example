# HawkBucks Telegram Bot environment configuration.
# Copy to .dev.vars for local development (never commit real values).

# Telegram Bot API token (Cloudflare Worker secret in production).
TELEGRAM_BOT_TOKEN=123456:ABC-EXAMPLE-ONLY

# Numeric Telegram user ID of the primary administrator.
# Required for Admin Panel access (usage statistics, active reminders,
# broadcast). Stored as a Cloudflare Worker Secret in production:
#   npx wrangler secret put ADMIN_TELEGRAM_ID
# Never commit the real value.
ADMIN_TELEGRAM_ID=YOUR_TELEGRAM_NUMERIC_ID


# Epic Games device-auth credentials used by the mission pipeline.
# Create a device auth via the Epic account public service, mirroring the
# configuration of the HawkBucks Worker (epic/).
EPIC_ACCOUNT_ID=your-epic-account-id
EPIC_DEVICE_ID=your-epic-device-id
EPIC_DEVICE_SECRET=your-epic-device-secret
# Value of the HTTP "Authorization" header sent to the Epic token endpoint,
# e.g. "basic <base64(client-id:client-secret)>".
EPIC_TOKEN_AUTH=basic your-base64-credentials

# ScreenshotOne access key, used only for rendering the daily mission image
# that is sent to Telegram (unrelated to mission data acquisition).
SCREENSHOTONE_ACCESS_KEY=your-screenshotone-key